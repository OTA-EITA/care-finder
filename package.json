{
  "name": "care-finder",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -f app/assets/builds/*.digested.js app/assets/builds/*.digested.js.map && esbuild app/javascript/application.ts --bundle --sourcemap --format=esm --splitting --chunk-names=[name]-[hash].digested --outdir=app/assets/builds --public-path=/assets --minify --define:process.env.NODE_ENV=\\\"production\\\"",
    "build:dev": "rm -f app/assets/builds/*.digested.js app/assets/builds/*.digested.js.map && esbuild app/javascript/application.ts --bundle --sourcemap --format=esm --splitting --chunk-names=[name]-[hash].digested --outdir=app/assets/builds --public-path=/assets",
    "build:css": "tailwindcss -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/application.css --minify",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
