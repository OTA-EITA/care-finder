# cp terraform.tfvars.example terraform.tfvars して値を入れる（terraform.tfvars はコミットしない）
environment     = "prod"
certificate_arn = "arn:aws:acm:ap-northeast-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"
app_hosts       = ["care-finder.example"]
image_tag       = "replace-with-git-sha"
alarm_email     = ""
