# See https://help.github.com/articles/ignoring-files for more about ignoring files.

/.bundle

# Environment files
/.env*
!/.env.example

/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Credentials keys
/config/master.key
/config/credentials/*.key

# Builds and dependencies
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules
/storybook-static

# Test output
/coverage
/test-results
/playwright-report
/blob-report
/spec/examples.txt

# Downloaded open data (importer caches here; never commit)
/tmp/open_data

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.tfstate.lock.info
