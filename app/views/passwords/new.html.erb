<% content_for :title, "パスワードの再設定" %>

<div class="mx-auto max-w-md">
  <h1 class="text-xl font-bold">パスワードの再設定</h1>
  <p class="mt-1 text-sm text-stone-600">登録したメールアドレスに再設定の案内を送ります。</p>

  <%= form_with url: passwords_path, class: "card mt-4 space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, "メールアドレス", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
    </div>
    <%= form.submit "案内を送る", class: "btn-primary w-full" %>
  <% end %>
</div>
