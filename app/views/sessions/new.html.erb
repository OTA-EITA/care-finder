<% content_for :title, "ログイン" %>

<div class="mx-auto max-w-md">
  <h1 class="text-xl font-bold">ログイン</h1>

  <%= form_with url: session_path, class: "card mt-4 space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, "メールアドレス", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
    </div>
    <div>
      <%= form.label :password, "パスワード", class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input" %>
    </div>
    <%= form.submit "ログイン", class: "btn-primary w-full" %>
  <% end %>

  <div class="mt-4 space-y-1 text-sm">
    <p><%= link_to "パスワードを忘れた方", new_password_path %></p>
    <p>はじめての方は<%= link_to "新規登録", new_registration_path %></p>
  </div>
</div>
