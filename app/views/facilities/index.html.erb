<% content_for :title, "事業所をさがす" %>

<div class="grid gap-6 md:grid-cols-[18rem_1fr]">
  <aside class="md:sticky md:top-4 md:self-start">
    <div class="card" data-controller="disclosure">
      <h2 class="mb-3 hidden text-sm font-bold text-stone-700 md:block">条件で絞り込む</h2>
      <button type="button" class="btn-secondary w-full md:hidden" aria-expanded="false" aria-controls="search-filters"
              data-disclosure-target="button" data-action="disclosure#toggle">絞り込み条件を開く</button>
      <div id="search-filters" class="hidden pt-4 md:block md:pt-0" data-disclosure-target="panel">
        <div data-react-island="SearchFilterPanel" data-props="<%= search_filter_props(@criteria, @result, @features).to_json %>">
          <%= render "facilities/filters", criteria: @criteria, result: @result %>
        </div>
      </div>
    </div>
  </aside>

  <section aria-labelledby="results-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h1 id="results-heading" class="text-xl font-bold">
        放課後等デイサービス・児童発達支援
        <span class="ml-2 text-base font-normal text-stone-600" data-testid="result-count"><%= number_with_delimiter(@result.total) %>件</span>
      </h1>
      <% if @result.origin %>
        <p class="text-sm text-stone-600"><%= @result.origin.label %>からの距離を表示しています</p>
      <% end %>
    </div>

    <% if @result.origin_not_found? %>
      <p role="status" class="mt-3 rounded-md border border-amber-200 bg-amber-50 px-4 py-2 text-sm text-amber-900">
        「<%= @criteria.near %>」の場所が見つかりませんでした。駅名（例: 帯広駅、天王寺駅）で入れてください。
      </p>
    <% end %>
    <% if @result.degraded? %>
      <p role="status" class="mt-3 rounded-md border border-amber-200 bg-amber-50 px-4 py-2 text-sm text-amber-900">
        検索サーバーに接続できないため、簡易検索で表示しています。
      </p>
    <% end %>

    <% if @result.facilities.empty? %>
      <div class="card mt-4 text-sm text-stone-700">
        <p>条件に合う事業所が見つかりませんでした。</p>
        <p class="mt-1">キーワードを短くするか、絞り込みを外してお試しください。</p>
      </div>
    <% else %>
      <div class="mt-4 grid gap-3">
        <% @result.facilities.each do |facility| %>
          <%= render "facilities/facility", facility:, distance: @result.distance_for(facility), origin: @result.origin %>
        <% end %>
      </div>
      <%= render "facilities/pagination", result: @result, criteria: @criteria %>
    <% end %>
  </section>
</div>
