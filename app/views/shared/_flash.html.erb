<% if notice.present? || alert.present? %>
  <div class="mx-auto w-full max-w-6xl px-4 pt-4">
    <% if notice.present? %>
      <p role="status" class="rounded-md border border-brand-100 bg-brand-50 px-4 py-2 text-sm text-brand-800"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p role="alert" class="rounded-md border border-red-200 bg-red-50 px-4 py-2 text-sm text-red-800"><%= alert %></p>
    <% end %>
  </div>
<% end %>
